# compile_commands.json contains raw nvcc command lines; clangd parses them
# as clang flags, so strip the nvcc-only options it rejects.
CompileFlags:
  CompilationDatabase: build
  Remove:
    - -forward-unknown-to-host-compiler
    - --expt-relaxed-constexpr
    - --expt-extended-lambda
    - --generate-code=*
    - -arch=*
    # -Xcompiler forwards to nvcc's host compiler (cl.exe on Windows); clang has
    # no such option and reports both instances as unknown arguments.
    - -Xcompiler=*
  Add:
    # Stripping -arch above leaves clang parsing the device pass for its sm_52
    # default, which is not the sm_120 target documented in CLAUDE.md and which
    # CUDA 13 no longer accepts. scripts/tidy.sh passes the same flag.
    - --cuda-gpu-arch=sm_120

# `-x cu` makes clangd run a CUDA device pass, and clang forbids `__host__`-only
# deduction guides there. CCCL's `cuda/std/string_view` declares exactly those,
# but nvcc's EDG frontend accepts them, so this diagnostic is a false positive.
Diagnostics:
  Suppress:
    - deduction_guide_target_attr
