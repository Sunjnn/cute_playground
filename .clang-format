BasedOnStyle: LLVM
Language: Cpp

ColumnLimit: 100

IndentWidth: 2
TabWidth: 2
ContinuationIndentWidth: 4
UseTab: Never
AccessModifierOffset: -2
IndentCaseLabels: false
NamespaceIndentation: None

BreakBeforeBraces: Attach
BraceWrapping:
  AfterFunction: false
  AfterClass: false
  AfterStruct: false
  AfterEnum: false
  AfterNamespace: false
  AfterControlStatement: Never
  BeforeElse: false
  BeforeCatch: false

PointerAlignment: Right
ReferenceAlignment: Right

IncludeBlocks: Regroup
# Grouped by where a header resolves to, not by bracket style: `third_party/cutlass` is
# spelled `"cute/..."` / `"cutlass/..."`, while the CUDA toolkit (`cuda_runtime.h`,
# `cccl/thrust`, `cccl/cub`, `cudnn.h`) is spelled `<...>` and counts as system. The first
# matching category wins, so the third_party rule must precede the generic `<...>` one.
IncludeCategories:
  - Regex: '^[<"](cute|cutlass)/'
    Priority: 2
    SortPriority: 2
  - Regex: '^<.*>'
    Priority: 1
    SortPriority: 1
  - Regex: '^".*"'
    Priority: 3
    SortPriority: 3
# A source file's own header leads the include block, but clang-format only maps a file to
# its main header when this regex is non-empty and matches the file name. The empty default
# still covers `.cpp` through a built-in extension list that omits `.cu`, so without this a
# `.cu` file's own `.cuh` would be sorted into the quoted block below the system headers.
IncludeIsMainRegex: '$'
IncludeIsMainSourceRegex: '$'
SortIncludes: CaseInsensitive

AllowShortFunctionsOnASingleLine: All
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Empty
AllowShortLambdasOnASingleLine: Inline

AlignAfterOpenBracket: AlwaysBreak
AlignOperands: Align
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 1

BinPackArguments: false
BinPackParameters: false
AllowAllArgumentsOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true

SpaceBeforeParens: ControlStatements
SpaceInEmptyBlock: false
SpacesInAngles: Never
SpacesInParentheses: false

FixNamespaceComments: true
CompactNamespaces: false

Cpp11BracedListStyle: true
SpaceBeforeCpp11BracedList: false

ConstructorInitializerIndentWidth: 0
BreakConstructorInitializers: BeforeComma
PackConstructorInitializers: NextLine
